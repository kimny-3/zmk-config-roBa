#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80
#define L_BASE 0
#define L_IME_TOGGLE 1
#define L_SHORTCUT 2
#define L_SYMBOL 3
#define L_NUMBER 4
#define L_MOUSE 5
#define L_SCROLL 6
#define L_BLUETOOTH 7

/ {
    mouse_temp_layer: mouse_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <400>;
    };
};

#define POS_LCLK    19
#define POS_MCLK    20
#define POS_RCLK    21
#define POS_SCROLL  8

&mouse_temp_layer {
    excluded-positions = <
            POS_LCLK
            POS_MCLK
            POS_RCLK
            POS_SCROLL
    >;
};

&trackball_listener {
    status = "okay";
    device = <&trackball>;
    input-processors = <&mouse_temp_layer L_MOUSE 10000>;
};

&mkp_input_listener {
    // <&node  LAYER  TIMEOUT_MS>

    input-processors = <&mouse_temp_layer L_MOUSE 10000>;
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <L_MOUSE>;

    scroll-layers = <L_SCROLL>;

    // arrows {
    //     layers = <L_NUMBER>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        BackSpace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        TAB0 {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        ESC_COMBO {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        Number_Layer {
            bindings = <&to 4>;
            key-positions = <40 28>;
        };

        parenthes {
            bindings = <&parenthes>;
            key-positions = <20 21>;
        };

        F10_combo {
            bindings = <&kp F10>;
            key-positions = <18 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        lang1_then_toggle: lang1_then_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap>, <&kp LANGUAGE_1>, <&macro_tap>, <&tog 1>;

            label = "LANG1_THEN_TOGGLE";
        };

        lang2_then_toggle: lang2_then_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_tap>, <&kp LANGUAGE_2>, <&macro_tap>, <&tog 1>;

            label = "LANG2_THEN_TOGGLE";
        };

        colon_lshift: colon_lshift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "COLON_LSHIFT";
        };

        tilde_lshift: tilde_lshift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "TILDE_LSHIFT";
        };

        parenthes: parenthes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LANG1>,
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS>,
                <&macro_tap>,
                <&kp RIGHT_PARENTHESIS>,
                <&macro_tap>,
                <&kp F10>,
                <&macro_tap>,
                <&kp ENTER>,
                <&macro_tap>,
                <&kp LEFT_ARROW>,
                <&macro_tap>;

            label = "PARENTHES";
        };
    };

    behaviors {
        ime_lang1_symbol: ime_lang1_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "IME_LANG1_SYMBOL";
            bindings = <&mo>, <&lang1_then_toggle>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        ime_lang2_symbol: ime_lang2_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "IME_LANG2_SYMBOL";
            bindings = <&mo>, <&lang2_then_toggle>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W      &kp E         &kp R                  &kp T                                              &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A      &kp S      &kp D         &kp F                  &kp G        &kp LG(RS(S))        &colon_lshift    &kp H        &kp J  &kp K      &kp L       &kp MINUS
&kp Z      &kp X      &kp C         &kp V                  &lt 5 B      &kp HASH             &kp DELETE       &kp N        &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&lt 7 TAB  &kp LCTRL  &kp LEFT_ALT  &ime_lang1_symbol 2 0  &lt 4 SPACE  &kp RIGHT_SHIFT      &lt 3 BACKSPACE  &lt 2 ENTER                                &kp LEFT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        IME_TOGGLE {
            bindings = <
&trans  &trans  &trans  &trans                 &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                 &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                 &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &ime_lang2_symbol 2 0  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SYMBOLE {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR      &kp PERCENT                                    &kp CARET  &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&tilde_lshift    &kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp LEFT_SHIFT  &kp C_MUTE      &kp APOS       &kp EQUAL  &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp UNDERSCORE
&kp GRAVE        &none           &none           &none           &kp SLASH       &none           &kp DELETE     &kp SEMI   &colon_lshift  &none             &none                 &none
&kp CAPSLOCK     &trans          &trans          &trans          &trans          &trans          &kp BACKSPACE  &kp RET                                                           &kp INT_RO
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ShortCut {
            bindings = <
&kp ESCAPE  &kp LG(L)  &trans       &trans     &kp LC(RS(T))                      &kp F1    &kp F2   &kp F3       &kp F4         &kp F5
&kp LC(A)   &kp TAB    &kp RS(TAB)  &trans     &trans         &trans      &trans  &kp F6    &kp F7   &kp F8       &kp F9         &kp F10
&kp LC(Z)   &kp LC(X)  &kp LC(C)    &kp LC(V)  &trans         &trans      &trans  &kp HOME  &kp END  &kp PAGE_UP  &kp PAGE_DOWN  &kp F11
&trans      &trans     &trans       &trans     &trans         &trans      &trans  &trans                                         &kp F12
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ARROW+NUMBER {
            bindings = <
&kp ESCAPE       &kp LC(RS(TAB))  &kp UP_ARROW    &kp LC(RS(TAB))  &trans                                                         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH  &kp KP_ASTERISK
&none            &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &colon_lshift  &kp C_MUTE           &kp TAB                    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COMMA     &kp KP_MINUS
&kp RIGHT_SHIFT  &none            &trans          &none            &trans         &to 0                &kp ENTER                  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &kp KP_PLUS
&kp KP_NUMLOCK   &trans           &trans          &trans           &trans         &kp RIGHT_SHIFT      &mt RIGHT_SHIFT BACKSPACE  &kp KP_NUMBER_0                                                  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        MOUSE {
            bindings = <
&none  &none      &none         &none  &none                              &none           &none           &none            &mkp MCLK  &none
&none  &none      &none         &none  &none  &none                &none  &none           &kp UP_ARROW    &mkp LCLK        &mo 6      &mkp RCLK
&none  &none      &none         &none  &none  &none                &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &none
&none  &kp LCTRL  &kp LEFT_ALT  &none  &none  &kp RIGHT_SHIFT      &none  &none                                                       &none
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp HOME     &trans  &kp END
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp PAGE_UP  &trans  &kp PAGE_DOWN
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                               &trans
            >;
        };

        Bluetooth {
            bindings = <
&none  &none  &none  &none  &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none  &none  &none      &sys_reset   &none         &none         &none         &none         &none
&none  &none  &none  &none  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR
&none  &none  &none  &none  &none  &none      &none        &none                                                   &bt BT_CLR_ALL
            >;
        };
    };
};
